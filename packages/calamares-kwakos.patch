--- a/modules/nixos/main.py
+++ b/modules/nixos/main.py
@@ -1044,2 +1044,67 @@
-    # Write the configuration.nix file
-    libcalamares.utils.host_env_process_output(["cp", "/dev/stdin", config], None, cfg)
+    # Install the kwakOS flake instead of the generic configuration normally
+    # generated by this module. Keep a writable copy on the target so its
+    # hardware configuration remains the source of truth for later deployments.
+    target_flake = os.path.join(root_mount_point, "etc/nixos/kwak-os")
+    try:
+        subprocess.check_output(
+            ["pkexec", "rm", "-rf", target_flake], stderr=subprocess.STDOUT
+        )
+        subprocess.check_output(
+            ["pkexec", "cp", "-R", "@KWAK_SOURCE@", target_flake],
+            stderr=subprocess.STDOUT,
+        )
+        subprocess.check_output(
+            ["pkexec", "chmod", "-R", "u+w", target_flake],
+            stderr=subprocess.STDOUT,
+        )
+        subprocess.check_output(
+            [
+                "pkexec",
+                "cp",
+                root_mount_point + "/etc/nixos/hardware-configuration.nix",
+                target_flake + "/hosts/physical/hardware-configuration.nix",
+            ],
+            stderr=subprocess.STDOUT,
+        )
+    except subprocess.CalledProcessError as e:
+        return (_("Failed to prepare kwakOS configuration"), _(e.output.decode("utf8")))
+
+    username = gs.value("username") or "kwak"
+    hostname = gs.value("hostname") or "kwakos"
+    fullname = gs.value("fullname") or username
+    timezone = variables.get("timezone", "America/Chicago")
+    locale = variables.get("LANG", "en_US.UTF-8")
+    keyboard_layout = variables.get("kblayout", "us")
+    keyboard_variant = variables.get("kbvariant", "")
+    console_keymap = variables.get("vconsole", "us")
+    installer_cfg = """{ ... }:
+{
+  networking.hostName = %s;
+  time.timeZone = %s;
+  i18n.defaultLocale = %s;
+  console.keyMap = %s;
+  services.xserver.xkb.layout = %s;
+  services.xserver.xkb.variant = %s;
+  users.users.%s = {
+    isNormalUser = true;
+    description = %s;
+    extraGroups = [ \"wheel\" \"networkmanager\" ];
+  };
+  services.displayManager.autoLogin.user = %s;
+}
+""" % (
+        json.dumps(hostname),
+        json.dumps(timezone),
+        json.dumps(locale),
+        json.dumps(console_keymap),
+        json.dumps(keyboard_layout),
+        json.dumps(keyboard_variant),
+        json.dumps(username),
+        json.dumps(fullname),
+        json.dumps(username),
+    )
+    libcalamares.utils.host_env_process_output(
+        ["cp", "/dev/stdin", target_flake + "/hosts/physical/installer-settings.nix"],
+        None,
+        installer_cfg,
+    )
@@ -1065,3 +1130,5 @@
